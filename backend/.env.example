# Copy this to .env and fill in your values
# Never commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
# Get this from Supabase: Settings > Database > Connection String > URI
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ── Razorpay ──────────────────────────────────────────────────────────────────
# From: dashboard.razorpay.com > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Setu Account Aggregator (sandbox) ─────────────────────────────────────────
# From: setu.co > AA product > sandbox credentials
SETU_CLIENT_ID=your_setu_client_id
SETU_CLIENT_SECRET=your_setu_client_secret
SETU_BASE_URL=https://fiu-sandbox.setu.co

# ── GST Suvidha Provider ──────────────────────────────────────────────────────
# From: developer.gst.gov.in (takes ~1 week to approve)
GST_API_KEY=your_gst_api_key
GST_BASE_URL=https://api.gst.gov.in

# ── App config ────────────────────────────────────────────────────────────────
# Temporary: default business ID to use for Razorpay webhooks
# Replace with proper business lookup once you have auth
DEFAULT_BUSINESS_ID=paste-a-uuid-here

# Minimum safe cash balance (INR) — below this triggers alerts
MINIMUM_SAFE_BALANCE=50000
